# Copy this file to .env (same folder as manage.py) and fill in real values.
# .env is already gitignored — never commit real secret keys.

DJANGO_SECRET_KEY=dev-only-secret-key-CHANGE-THIS-IN-PRODUCTION-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Billing (PayPal — SANDBOX/TEST MODE) -------------------------------
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
# to get a Client ID + Secret. Sandbox credentials never move real money —
# only PayPal sandbox "buyer" test accounts (also created in that dashboard,
# under Sandbox -> Accounts) can pay with them. See billing/paypal.py and
# billing/views.py for how these are used, and README.md for step-by-step
# testing instructions.
SITE_URL=http://127.0.0.1:8000

# 'sandbox' for testing (default), 'live' once you switch to real credentials.
PAYPAL_MODE=sandbox

PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# From your PayPal app's Webhooks section (Add Webhook -> point it at
# https://<your-site>/billing/webhook/paypal/ -> subscribe to at least
# "Checkout order approved" and "Payment capture completed"). Needed to
# verify incoming webhook requests really came from PayPal.
PAYPAL_WEBHOOK_ID=your-webhook-id
