# Copy this file to .env (same folder as manage.py) and fill in real values.
# .env is already gitignored — never commit real secret keys.

DJANGO_SECRET_KEY=dev-only-secret-key-CHANGE-THIS-IN-PRODUCTION-1234567890
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Billing ----------------------------------------------------------
# No payment processor is used in this build. Plans "checkout" is really
# just a free trial toggle (see billing/views.py) — nothing to configure.

SITE_URL=http://127.0.0.1:8000
